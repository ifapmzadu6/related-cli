{
  "name": "related-cli",
  "version": "1.0.1",
  "description": "Audit changed sets for omitted companion files using Git co-change history",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ifapmzadu6/related-cli.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "related": "npm/bin/related.js",
    "related-install-skill": "npm/bin/install-skill.js"
  },
  "files": [
    "skills/find-related-files/**",
    "npm/bin/install-skill.js",
    "npm/bin/related.js",
    "npm/prebuilt/**",
    "npm/scripts/postinstall.js",
    "npm/scripts/verify-prebuilt.js",
    "docs/**",
    "README.md",
    "MEASUREMENTS.md"
  ],
  "scripts": {
    "postinstall": "node npm/scripts/postinstall.js",
    "prepack": "node npm/scripts/verify-prebuilt.js",
    "stage:local": "scripts/stage_npm_prebuilt.sh --local",
    "verify:prebuilt": "node npm/scripts/verify-prebuilt.js"
  },
  "engines": {
    "node": ">=14"
  },
  "keywords": [
    "git",
    "cli",
    "llm",
    "cochange",
    "related-files"
  ]
}
